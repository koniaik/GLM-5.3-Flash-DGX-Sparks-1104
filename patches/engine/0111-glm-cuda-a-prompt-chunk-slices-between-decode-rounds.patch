+                steps[twin] += 1;
+                if (r.first) |f| break f;
+                if (e.partial) |p| at = p.start else at += r.rows; // a suspended chunk resumes where it stands
+            };
+            firsts[twin] = first;
+            // a sampled stream: each round's window the token the last drew, kept at its first row
+            var t = first;
+            for (0..rounds) |r| {
+                const win = [_]u32{t};
+                try x.verify(&win, stream[twin][r..][0..1], 0);
+                try x.keep(1);
+                t = stream[twin][r];
+            }
+            logits[twin] = try a.alloc(u16, V);
+            try gpu.d.check(gpu.d.api.cuMemcpyDtoH_v2(logits[twin].ptr, e.bd.logits, V * 2), "cuMemcpyDtoH");
+        }
+        most_slices = @max(most_slices, steps[1]);
+        if (steps[0] != (len + C - 1) / C or steps[1] < steps[0] * L) {
+            std.debug.print("FAIL slice: prompt of {d}: {d} whole steps, {d} sliced (want {d} chunks, at least {d} slices)\n", .{ len, steps[0], steps[1], (len + C - 1) / C, steps[0] * L });
+            failed = true;
+        }
+        if (firsts[0] != firsts[1] or !std.mem.eql(u32, &stream[0], &stream[1]) or !std.mem.eql(u16, logits[0], logits[1])) {
+            std.debug.print("FAIL slice: prompt of {d}: first {d}/{d}, the sampled stream or the next window's logits differ\n", .{ len, firsts[0], firsts[1] });
+            failed = true;
+        }
+        try e.stream.synchronize();
+        const st = &e.seqs.items[2 * i].?.st;
+        const tw = &e.seqs.items[2 * i + 1].?.st;
+        const n = st.arena.buf.len;
+        const h0 = try a.alloc(u8, n);
+        const h1 = try a.alloc(u8, n);
+        try st.arena.buf.download(0, h0);
+        try tw.arena.buf.download(0, h1);
+        const diff = std.mem.indexOfDiff(u8, h0, h1);
+        if (st.pos != tw.pos or st.mtp_len != tw.mtp_len or !std.mem.eql(u1, st.cur, tw.cur) or diff != null) {
+            std.debug.print("FAIL slice: prompt of {d}: the sliced state differs (pos {d}/{d}, first byte {?d} of {d})\n", .{ len, st.pos, tw.pos, diff, n });
+            failed = true;
+        }
+    }
+    // a chunk cancelled between two of its slices: the slot's next pass is its whole twin's, bit for bit
+    {
+        const len = 2 * C + 5;
+        const ids = try a.alloc(u32, len);
+        for (ids, 0..) |*u, j| u.* = @intCast(200 + (j * 104729 + 7) % 5000);
+        var firsts: [2]u32 = undefined;
+        for (0..2) |twin| {
+            try x.bind(@intCast(10 + twin));
+            try x.begin(null);
+            if (twin == 1) {
+                _ = try x.chunkSliced(ids, 0, false, null, budget, null, null);
+                _ = try x.chunkSliced(ids, 0, false, null, budget, null, null); // two slices in, the chunk suspended
+                try x.cancelSlice(0, null);
+            }
+            var at: usize = 0;
+            const first = while (true) {
+                const r = if (twin == 1) try x.chunkSliced(ids, at, false, null, budget, null, null) else try x.chunk(ids, at, false, null, null, null);
+                if (r.first) |f| break f;
+                if (e.partial) |p| at = p.start else at += r.rows;
+            };
+            firsts[twin] = first;
+        }
+        if (firsts[0] != firsts[1]) {
+            std.debug.print("FAIL slice: a cancelled chunk's next pass draws {d}, the whole twin {d}\n", .{ firsts[1], firsts[0] });
+            failed = true;
+        }
+    }
+    if (e.partial != null) {
+        std.debug.print("FAIL slice: a chunk stays suspended at the end\n", .{});
+        failed = true;
+    }
+    if (failed) return error.TestFailed;
+    check.pass("layer-sliced prompt chunks at TP={d}: prompts of {any} rows cut a layer a slice ({d} slices at most) equal their whole twins in the first token, the sampled stream after it, the next window's logits and every state byte; a chunk cancelled between slices leaves its slot the whole one's bits", .{ world, lens, most_slices });
+}
