+    /// The next slice's end layer of the bound slot's chunk (rank 0 picks it; the step's header carries it to the
+    /// other ranks): the first chunk with slicing calibrates whole -- a CUDA event a layer, no server-startup probe
+    /// as the Python family's -- and the rest cut where the learned costs say.
+    pub fn sliceHi(e: *Engine, rows: usize, lo: usize, budget: f64) !usize {
+        const layers = e.w.layers.len;
+        if (lo >= layers) return error.BadSlice;
+        if (e.slice_costs.ready()) return e.slice_costs.stop(rows, lo, budget);
+        if (e.slice_cal == null) {
+            const ev = try e.gpa.alloc(cuda.Event, layers + 1);
+            errdefer e.gpa.free(ev);
+            var made: usize = 0;
+            errdefer for (ev[0..made]) |*x| x.deinit();
+            for (ev) |*x| {
+                x.* = try cuda.Event.init(e.d, true); // timing events: the ms between them is the layer's cost
+                made += 1;
+            }
+            e.slice_cal = ev;
+        }
+        return layers;
+    }
+
+    /// `slot`'s suspended chunk drops without its commit (a cancel between slices, or a release): its layers already
+    /// wrote their caches, so the sequence waits for its next begin's reset or a kept state's restore, as a chunk
+    /// cancelled at its gate does. Returns whether one was held (both ranks hold the same one, by its slot).
+    pub fn dropPartialOf(e: *Engine, slot: u32) bool {
+        if (e.partial) |*p| if (p.slot == slot) {
+            e.gpa.free(p.part);
+            e.partial = null;
+            return true;
+        };
+        return false;
+    }
+
+    /// One slice of a prompt chunk's layers (TF_GLM_FILL_SLICE_MS, the Leader's chunkpart step): the chunk at `start`
+    /// opens with prefillChunk's head through the gate, then runs its layers [j, hi) -- a suspended chunk resuming at
+    /// its `j` -- and hi == the layer count finishes it with prefillChunk's tail and commit, exactly as the whole
+    /// chunk would (a slice never commits part-way, so kept states stay on the chunk grid). `hi` is rank 0's sliceHi
+    /// pick, every rank running the same range: the kernels, their arguments and their order are prefillChunk's.
+    pub fn prefillChunkSlice(e: *Engine, part: []const u32, start: usize, len: usize, from: ?Resume, cancel: ?Cancel, marks: ?Marks, hi: usize) !?u32 {
+        const t0 = std.Io.Clock.awake.now(e.io).toNanoseconds();
+        const layers = e.w.layers.len;
+        if (hi == 0 or hi > layers) return error.BadSlice;
+        var one: [1]fw.Rank = undefined;
+        var f = e.view(&e.bp, &one);
+        var rows: usize = undefined;
+        var lo: usize = undefined;
+        if (e.partial) |p| { // a suspended chunk's next slice: the flags as its first slice ran them
+            if (p.slot != e.slot or p.start != start or p.len != len or p.j >= hi) return error.BadChunk;
+            rows = p.rows;
+            lo = p.j;
+            f.index_split = p.split;
+            f.taps = p.taps;
+            f.prof = e.prompt_profs[promptProfAt(rows)];
+            e.profiling_prompt = f.prof; // the chunk's prof stays open across its slices; foreign steps must not mark it
+        } else { // the chunk's first slice: prefillChunk's head, through the gate
+            const split = e.index_split; // this step's alone
+            e.index_split = false;
+            if ((from != null or start == 0) and try e.prefillStart(len, from) != start) return error.BadChunk;
+            if (start >= len or start % fw.prefill_rows != 0) return error.BadChunk;
+            rows = @min(len - start, fw.prefill_rows);
